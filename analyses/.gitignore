# output_dir is pointed inside it.
work/
outputs/
private/
*.nii
*.nii.gz
*.mgz
*.mat
*.npz
*.npy
*.csv
*.tsv
*.png
*.pdf
*.tif
*.svg
logs/

# Atlas downloads.
atlases/

# Label specifications are text and stay tracked.
!atlas_nuclei_tracts/*.json
