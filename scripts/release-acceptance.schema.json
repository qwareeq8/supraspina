{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/qwareeq8/supraspina/blob/main/scripts/release-acceptance.schema.json",
  "title": "Supraspina native release acceptance",
  "description": "Canonical native Ubuntu build and host evidence with its merged stable-release record.",
  "oneOf": [
    {
      "$ref": "#/$defs/nativeBuildRecord"
    },
    {
      "$ref": "#/$defs/hostRecord"
    },
    {
      "$ref": "#/$defs/mergedRecord"
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "objectId": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bytes", "sha256"],
      "properties": {
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "packageName",
        "productName",
        "version",
        "tag",
        "target"
      ],
      "properties": {
        "repository": {
          "const": "https://github.com/qwareeq8/supraspina"
        },
        "packageName": {
          "const": "supraspina"
        },
        "productName": {
          "const": "Supraspina"
        },
        "version": {
          "type": "string",
          "pattern": "^[1-9][0-9]{7}\\.(0|[1-9][0-9]{0,3})\\.0$"
        },
        "tag": {
          "type": "string",
          "pattern": "^v[1-9][0-9]{7}\\.(0|[1-9][0-9]{0,3})\\.0$"
        },
        "target": {
          "const": "linux-x86_64"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "tree", "clean"],
      "properties": {
        "repository": {
          "const": "https://github.com/qwareeq8/supraspina"
        },
        "commit": {
          "$ref": "#/$defs/objectId"
        },
        "tree": {
          "$ref": "#/$defs/objectId"
        },
        "clean": {
          "const": true
        }
      }
    },
    "packageManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filename", "bytes", "sha256"],
      "properties": {
        "filename": {
          "const": "release-package-manifest.json"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "buildToolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodeEngine",
        "python",
        "pip",
        "electron",
        "electronBuilder",
        "electronVite",
        "pyinstaller",
        "micromambaRelease",
        "micromambaSha256"
      ],
      "properties": {
        "nodeEngine": {
          "$ref": "#/$defs/oneLine"
        },
        "python": {
          "$ref": "#/$defs/oneLine"
        },
        "pip": {
          "$ref": "#/$defs/oneLine"
        },
        "electron": {
          "$ref": "#/$defs/oneLine"
        },
        "electronBuilder": {
          "$ref": "#/$defs/oneLine"
        },
        "electronVite": {
          "$ref": "#/$defs/oneLine"
        },
        "pyinstaller": {
          "$ref": "#/$defs/oneLine"
        },
        "micromambaRelease": {
          "$ref": "#/$defs/oneLine"
        },
        "micromambaSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "oneLine": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[^\\r\\n\\u0000]+$"
    },
    "signing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "reasonCode", "artifacts"],
      "properties": {
        "decision": {
          "const": "unsigned"
        },
        "reasonCode": {
          "const": "no-linux-package-signing-identity"
        },
        "artifacts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["AppImage", "deb"],
          "properties": {
            "AppImage": {
              "const": "unsigned"
            },
            "deb": {
              "const": "unsigned"
            }
          }
        }
      }
    },
    "artifacts": {
      "type": "object",
      "minProperties": 3,
      "maxProperties": 3,
      "propertyNames": {
        "pattern": "^(latest-linux\\.yml|supraspina-[0-9]{8}\\.[0-9]+\\.0-(amd64\\.deb|x86_64\\.AppImage))$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/identity"
      }
    },
    "argv": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/oneLine"
      }
    },
    "automatedCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "argv"],
      "properties": {
        "id": {
          "enum": ["deb-smoke", "appimage-smoke", "package-inspection"]
        },
        "argv": {
          "$ref": "#/$defs/argv"
        }
      }
    },
    "buildCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "argv", "environment"],
      "properties": {
        "id": {
          "enum": [
            "node-install",
            "verify-python-version",
            "create-release-python",
            "install-python-toolchain",
            "install-python-release",
            "install-sidecar-source",
            "check-python-release",
            "download-micromamba",
            "verify-micromamba-sha256",
            "make-micromamba-executable",
            "verify-micromamba-version",
            "generate-node-metadata",
            "generate-python-metadata",
            "package-linux"
          ]
        },
        "argv": {
          "$ref": "#/$defs/argv"
        },
        "environment": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/oneLine"
          }
        },
        "standardInput": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      }
    },
    "normalLaunchCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "argvSequence", "successCondition"],
      "properties": {
        "id": {
          "enum": ["deb-normal-launch", "appimage-normal-launch"]
        },
        "argvSequence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/argv"
          }
        },
        "successCondition": {
          "$ref": "#/$defs/oneLine"
        }
      }
    },
    "implementationInputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "electron-builder.yml",
        "electron.vite.config.ts",
        "package.json",
        "scripts/app-version.mjs",
        "scripts/build-identity.mjs",
        "scripts/build-sidecar.sh",
        "scripts/bundled-packages.mjs",
        "scripts/check-release.mjs",
        "scripts/generate-node-release-metadata.mjs",
        "scripts/inspect-linux-packages.mjs",
        "scripts/package-smoke.mjs",
        "scripts/release-acceptance.mjs",
        "scripts/release-acceptance.schema.json",
        "scripts/release-assets.mjs",
        "scripts/release-package-manifest.mjs",
        "scripts/smoke-appimage.sh",
        "scripts/smoke-installed-deb.sh",
        "scripts/stage-sidecar-resources.mjs",
        "scripts/stamp-version.mjs",
        "scripts/verify-packaged-application.mjs",
        "sidecar/scripts/generate_release_metadata.py",
        "sidecar/supraspina-sidecar.spec"
      ],
      "properties": {
        "electron-builder.yml": {
          "$ref": "#/$defs/identity"
        },
        "electron.vite.config.ts": {
          "$ref": "#/$defs/identity"
        },
        "package.json": {
          "$ref": "#/$defs/identity"
        },
        "scripts/app-version.mjs": {
          "$ref": "#/$defs/identity"
        },
        "scripts/build-identity.mjs": {
          "$ref": "#/$defs/identity"
        },
        "scripts/build-sidecar.sh": {
          "$ref": "#/$defs/identity"
        },
        "scripts/bundled-packages.mjs": {
          "$ref": "#/$defs/identity"
        },
        "scripts/check-release.mjs": {
          "$ref": "#/$defs/identity"
        },
        "scripts/generate-node-release-metadata.mjs": {
          "$ref": "#/$defs/identity"
        },
        "scripts/inspect-linux-packages.mjs": {
          "$ref": "#/$defs/identity"
        },
        "scripts/package-smoke.mjs": {
          "$ref": "#/$defs/identity"
        },
        "scripts/release-acceptance.mjs": {
          "$ref": "#/$defs/identity"
        },
        "scripts/release-acceptance.schema.json": {
          "$ref": "#/$defs/identity"
        },
        "scripts/release-assets.mjs": {
          "$ref": "#/$defs/identity"
        },
        "scripts/release-package-manifest.mjs": {
          "$ref": "#/$defs/identity"
        },
        "scripts/smoke-appimage.sh": {
          "$ref": "#/$defs/identity"
        },
        "scripts/smoke-installed-deb.sh": {
          "$ref": "#/$defs/identity"
        },
        "scripts/stage-sidecar-resources.mjs": {
          "$ref": "#/$defs/identity"
        },
        "scripts/stamp-version.mjs": {
          "$ref": "#/$defs/identity"
        },
        "scripts/verify-packaged-application.mjs": {
          "$ref": "#/$defs/identity"
        },
        "sidecar/scripts/generate_release_metadata.py": {
          "$ref": "#/$defs/identity"
        },
        "sidecar/supraspina-sidecar.spec": {
          "$ref": "#/$defs/identity"
        }
      }
    },
    "commandContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workingDirectory",
        "assetDirectoryToken",
        "buildCommands",
        "automatedChecks",
        "normalLaunchChecks",
        "implementationInputs"
      ],
      "properties": {
        "workingDirectory": {
          "const": "repository-root"
        },
        "assetDirectoryToken": {
          "const": "<accepted-assets>"
        },
        "buildCommands": {
          "type": "array",
          "minItems": 14,
          "maxItems": 14,
          "items": {
            "$ref": "#/$defs/buildCommand"
          }
        },
        "automatedChecks": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/automatedCheck"
          }
        },
        "normalLaunchChecks": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/normalLaunchCheck"
          }
        },
        "implementationInputs": {
          "$ref": "#/$defs/implementationInputs"
        }
      }
    },
    "common": {
      "type": "object",
      "required": [
        "release",
        "source",
        "packageManifest",
        "buildToolchain",
        "signing",
        "artifacts",
        "commandContract"
      ],
      "properties": {
        "release": {
          "$ref": "#/$defs/release"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "packageManifest": {
          "$ref": "#/$defs/packageManifest"
        },
        "buildToolchain": {
          "$ref": "#/$defs/buildToolchain"
        },
        "signing": {
          "$ref": "#/$defs/signing"
        },
        "artifacts": {
          "$ref": "#/$defs/artifacts"
        },
        "commandContract": {
          "$ref": "#/$defs/commandContract"
        }
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "distribution",
        "version",
        "architecture",
        "kernelRelease",
        "wsl"
      ],
      "properties": {
        "distribution": {
          "const": "ubuntu"
        },
        "version": {
          "enum": ["22.04", "24.04"]
        },
        "architecture": {
          "const": "x86_64"
        },
        "kernelRelease": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._+~-]{1,128}$"
        },
        "wsl": {
          "const": false
        }
      }
    },
    "buildHost": {
      "allOf": [
        {
          "$ref": "#/$defs/host"
        },
        {
          "type": "object",
          "properties": {
            "version": {
              "const": "22.04"
            }
          }
        }
      ]
    },
    "buildTools": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node",
        "npm",
        "python",
        "pip",
        "bash",
        "curl",
        "sha256sum",
        "file",
        "dpkgDeb",
        "glibc",
        "electron",
        "electronBuilder",
        "electronVite",
        "pyinstaller",
        "micromamba"
      ],
      "properties": {
        "node": {
          "$ref": "#/$defs/oneLine"
        },
        "npm": {
          "$ref": "#/$defs/oneLine"
        },
        "python": {
          "$ref": "#/$defs/oneLine"
        },
        "pip": {
          "$ref": "#/$defs/oneLine"
        },
        "bash": {
          "$ref": "#/$defs/oneLine"
        },
        "curl": {
          "$ref": "#/$defs/oneLine"
        },
        "sha256sum": {
          "$ref": "#/$defs/oneLine"
        },
        "file": {
          "$ref": "#/$defs/oneLine"
        },
        "dpkgDeb": {
          "$ref": "#/$defs/oneLine"
        },
        "glibc": {
          "$ref": "#/$defs/oneLine"
        },
        "electron": {
          "$ref": "#/$defs/oneLine"
        },
        "electronBuilder": {
          "$ref": "#/$defs/oneLine"
        },
        "electronVite": {
          "$ref": "#/$defs/oneLine"
        },
        "pyinstaller": {
          "$ref": "#/$defs/oneLine"
        },
        "micromamba": {
          "$ref": "#/$defs/oneLine"
        }
      }
    },
    "buildCommandResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "exitCode"],
      "properties": {
        "status": {
          "enum": ["passed", "failed", "not-run"]
        },
        "exitCode": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 255
        }
      },
      "oneOf": [
        {
          "properties": {
            "status": {
              "const": "passed"
            },
            "exitCode": {
              "const": 0
            }
          }
        },
        {
          "properties": {
            "status": {
              "const": "failed"
            },
            "exitCode": {
              "type": "integer",
              "minimum": 1,
              "maximum": 255
            }
          }
        },
        {
          "properties": {
            "status": {
              "const": "not-run"
            },
            "exitCode": {
              "type": "null"
            }
          }
        }
      ]
    },
    "buildCommandResults": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node-install",
        "verify-python-version",
        "create-release-python",
        "install-python-toolchain",
        "install-python-release",
        "install-sidecar-source",
        "check-python-release",
        "download-micromamba",
        "verify-micromamba-sha256",
        "make-micromamba-executable",
        "verify-micromamba-version",
        "generate-node-metadata",
        "generate-python-metadata",
        "package-linux"
      ],
      "properties": {
        "node-install": {
          "$ref": "#/$defs/buildCommandResult"
        },
        "verify-python-version": {
          "$ref": "#/$defs/buildCommandResult"
        },
        "create-release-python": {
          "$ref": "#/$defs/buildCommandResult"
        },
        "install-python-toolchain": {
          "$ref": "#/$defs/buildCommandResult"
        },
        "install-python-release": {
          "$ref": "#/$defs/buildCommandResult"
        },
        "install-sidecar-source": {
          "$ref": "#/$defs/buildCommandResult"
        },
        "check-python-release": {
          "$ref": "#/$defs/buildCommandResult"
        },
        "download-micromamba": {
          "$ref": "#/$defs/buildCommandResult"
        },
        "verify-micromamba-sha256": {
          "$ref": "#/$defs/buildCommandResult"
        },
        "make-micromamba-executable": {
          "$ref": "#/$defs/buildCommandResult"
        },
        "verify-micromamba-version": {
          "$ref": "#/$defs/buildCommandResult"
        },
        "generate-node-metadata": {
          "$ref": "#/$defs/buildCommandResult"
        },
        "generate-python-metadata": {
          "$ref": "#/$defs/buildCommandResult"
        },
        "package-linux": {
          "$ref": "#/$defs/buildCommandResult"
        }
      }
    },
    "tools": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node",
        "npm",
        "bash",
        "dpkg",
        "apt",
        "file",
        "xvfbPackage",
        "fusePackage"
      ],
      "properties": {
        "node": {
          "$ref": "#/$defs/oneLine"
        },
        "npm": {
          "$ref": "#/$defs/oneLine"
        },
        "bash": {
          "$ref": "#/$defs/oneLine"
        },
        "dpkg": {
          "$ref": "#/$defs/oneLine"
        },
        "apt": {
          "$ref": "#/$defs/oneLine"
        },
        "file": {
          "$ref": "#/$defs/oneLine"
        },
        "xvfbPackage": {
          "$ref": "#/$defs/oneLine"
        },
        "fusePackage": {
          "$ref": "#/$defs/oneLine"
        }
      }
    },
    "results": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "debSmoke",
        "appImageSmoke",
        "packageInspection",
        "debNormalLaunch",
        "appImageNormalLaunch",
        "pybrainageProvisioning",
        "pybrainageReadiness",
        "syntheticOutputReopen"
      ],
      "properties": {
        "debSmoke": {
          "$ref": "#/$defs/outcome"
        },
        "appImageSmoke": {
          "$ref": "#/$defs/outcome"
        },
        "packageInspection": {
          "$ref": "#/$defs/outcome"
        },
        "debNormalLaunch": {
          "$ref": "#/$defs/outcome"
        },
        "appImageNormalLaunch": {
          "$ref": "#/$defs/outcome"
        },
        "pybrainageProvisioning": {
          "$ref": "#/$defs/outcome"
        },
        "pybrainageReadiness": {
          "$ref": "#/$defs/outcome"
        },
        "syntheticOutputReopen": {
          "$ref": "#/$defs/outcome"
        }
      }
    },
    "outcome": {
      "enum": ["passed", "failed", "not-run"]
    },
    "nativeBuildRecord": {
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/common"
        },
        {
          "type": "object",
          "required": [
            "schemaVersion",
            "recordType",
            "host",
            "tools",
            "commandResults"
          ],
          "properties": {
            "schemaVersion": {
              "const": 1
            },
            "recordType": {
              "const": "supraspina-native-build"
            },
            "host": {
              "$ref": "#/$defs/buildHost"
            },
            "tools": {
              "$ref": "#/$defs/buildTools"
            },
            "commandResults": {
              "$ref": "#/$defs/buildCommandResults"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "hostRecord": {
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/common"
        },
        {
          "type": "object",
          "required": [
            "schemaVersion",
            "recordType",
            "buildRecordSha256",
            "host",
            "tools",
            "results"
          ],
          "properties": {
            "schemaVersion": {
              "const": 1
            },
            "recordType": {
              "const": "supraspina-native-host-acceptance"
            },
            "buildRecordSha256": {
              "$ref": "#/$defs/sha256"
            },
            "host": {
              "$ref": "#/$defs/host"
            },
            "tools": {
              "$ref": "#/$defs/tools"
            },
            "results": {
              "$ref": "#/$defs/results"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "publishedHost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "record"],
      "properties": {
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "record": {
          "$ref": "#/$defs/hostRecord"
        }
      }
    },
    "publishedBuild": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "record"],
      "properties": {
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "record": {
          "$ref": "#/$defs/nativeBuildRecord"
        }
      }
    },
    "mergedRecord": {
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/common"
        },
        {
          "type": "object",
          "required": [
            "schemaVersion",
            "recordType",
            "buildRecord",
            "hostRecords"
          ],
          "properties": {
            "schemaVersion": {
              "const": 1
            },
            "recordType": {
              "const": "supraspina-release-acceptance"
            },
            "buildRecord": {
              "$ref": "#/$defs/publishedBuild"
            },
            "hostRecords": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "$ref": "#/$defs/publishedHost"
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    }
  }
}
